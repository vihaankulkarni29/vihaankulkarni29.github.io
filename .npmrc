# @studio-freight/react-lenis declares peerDeps on react/react-dom ^17 || ^18,
# but this project runs React 19. Plain `npm ci` / `npm install` fails with
# ERESOLVE, which breaks the Vercel build (it runs npm ci when a lockfile exists).
# Remove this file once SmoothScroll migrates to the maintained `lenis` package.
legacy-peer-deps=true